{
  "openapi": "3.1.0",
  "info": {
    "title": "YuLab foundation API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./lab.schema.json#/$defs/Health"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./lab.schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./lab.schema.json#/$defs/Capabilities"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./lab.schema.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/captures": {
      "post": {
        "operationId": "createCapture",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./lab.schema.json#/$defs/CaptureRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Capture accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "./lab.schema.json#/$defs/CaptureJob" }
              }
            }
          },
          "422": {
            "description": "Invalid capture request",
            "content": {
              "application/json": {
                "schema": { "$ref": "./lab.schema.json#/$defs/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "getCaptureJob",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "$ref": "./lab.schema.json#/$defs/Id" } }
        ],
        "responses": {
          "200": {
            "description": "Capture job",
            "content": {
              "application/json": {
                "schema": { "$ref": "./lab.schema.json#/$defs/CaptureJob" }
              }
            }
          },
          "404": {
            "description": "Unknown capture job",
            "content": {
              "application/json": {
                "schema": { "$ref": "./lab.schema.json#/$defs/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancelCaptureJob",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "$ref": "./lab.schema.json#/$defs/Id" } }
        ],
        "responses": {
          "200": {
            "description": "Cancellation requested",
            "content": {
              "application/json": {
                "schema": { "$ref": "./lab.schema.json#/$defs/CaptureJob" }
              }
            }
          },
          "404": {
            "description": "Unknown capture job",
            "content": {
              "application/json": {
                "schema": { "$ref": "./lab.schema.json#/$defs/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/artifacts/{artifact_id}": {
      "get": {
        "operationId": "getCaptureArtifact",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "$ref": "./lab.schema.json#/$defs/Id" } },
          { "name": "artifact_id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
        ],
        "responses": {
          "200": {
            "description": "Published capture artifact",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": {
            "description": "Unknown or unpublished artifact",
            "content": {
              "application/json": {
                "schema": { "$ref": "./lab.schema.json#/$defs/ApiError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetRecord": {
        "$ref": "./lab.schema.json#/$defs/AssetRecord"
      },
      "WorldSpec": {
        "$ref": "./lab.schema.json#/$defs/WorldSpec"
      },
      "RigSpec": {
        "$ref": "./lab.schema.json#/$defs/RigSpec"
      },
      "EnvironmentSpec": {
        "$ref": "./lab.schema.json#/$defs/EnvironmentSpec"
      },
      "CapturePlan": {
        "$ref": "./lab.schema.json#/$defs/CapturePlan"
      },
      "CaptureRequest": {
        "$ref": "./lab.schema.json#/$defs/CaptureRequest"
      },
      "CaptureJob": {
        "$ref": "./lab.schema.json#/$defs/CaptureJob"
      },
      "ObservationBundle": {
        "$ref": "./lab.schema.json#/$defs/ObservationBundle"
      },
      "AnnotationBundle": {
        "$ref": "./lab.schema.json#/$defs/AnnotationBundle"
      },
      "TruthBundle": {
        "$ref": "./lab.schema.json#/$defs/TruthBundle"
      },
      "DatasetManifest": {
        "$ref": "./lab.schema.json#/$defs/DatasetManifest"
      },
      "PredictionBundle": {
        "$ref": "./lab.schema.json#/$defs/PredictionBundle"
      },
      "Health": {
        "$ref": "./lab.schema.json#/$defs/Health"
      },
      "Capabilities": {
        "$ref": "./lab.schema.json#/$defs/Capabilities"
      },
      "ApiError": {
        "$ref": "./lab.schema.json#/$defs/ApiError"
      }
    },
    "responses": {
      "NotFound": {
        "description": "Unknown API operation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./lab.schema.json#/$defs/ApiError"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Unsupported method",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "./lab.schema.json#/$defs/ApiError"
            }
          }
        }
      }
    }
  }
}
