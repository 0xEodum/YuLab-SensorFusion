# These sidecars are addressed by raw byte hashes; Windows checkout must not rewrite them.
frontend/public/catalog/*.json text eol=lf
*.glb binary
# Captured evidence retains CRLF and diagnostic-line whitespace byte-for-byte.
docs/evidence/sf04/* -text -whitespace
docs/evidence/sf05/*.log -text -whitespace
docs/evidence/sf05/*.json -text
# SF-06 retained artifacts are addressed by the raw hashes in its manifest.
docs/evidence/sf06/*.json -text
docs/evidence/sf06/*.png binary
# SF-12 comparison artifacts are addressed by raw byte hashes across platforms.
docs/evidence/sf12/* -text whitespace=cr-at-eol
# Matplotlib retains significant path formatting in its generated SVG artifact.
docs/evidence/sf12/*.svg -whitespace
